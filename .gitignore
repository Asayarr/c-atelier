# ============================================
#  C 学习仓库 .gitignore
#  原则：只提交源码(.c/.h)和笔记，忽略"编译产出的东西"
#  注意：.gitignore 不支持行尾注释，注释必须单独占一行
# ============================================

# ---------- 编译中间文件 / 常见产物 ----------
*.o
*.obj
*.out
a.out
*.exe
*.dll
*.so
*.dSYM/
*.gch

# ---------- 可执行文件（gcc ex5.c -o ex5 这种同名无扩展名的产物）----------
# 习惯一：lessons 里 exN.c -> exN
lessons/**/ex[0-9]*
!lessons/**/ex[0-9]*.c
# 习惯二：手动命名的可执行文件
lessons/**/hello
lessons/**/int_demo
lessons/**/pp1
lessons/**/pp2
lessons/**/pa_1
lessons/**/pa_2
lessons/**/ptr_ex
lessons/**/calc
projects/**/calc_app
projects/**/contacts

# ---------- problem/ 里只保留 .c 源码 ----------
# 刷题时直接 gcc 1045.c -o 1045，产物没有扩展名，用"排除法"统一忽略
problem/*
!problem/*.c
!problem/*.md

# ---------- 个人学习文档（不想提交到仓库）----------
notes/八股文.md

# ---------- 编辑器 / 操作系统 ----------
# 想保留 VS Code 配置就删掉下面这行
.vscode/
*.swp
*~
.DS_Store